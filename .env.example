#################################################
# Aero-Sense Environment Configuration
# Google Cloud Partner Hackathon 2025
#
# IMPORTANT:
# 1. Copy this file to .env
# 2. Fill in your actual API keys and credentials
# 3. NEVER commit .env to git
#################################################

#################################################
# APPLICATION SETTINGS
#################################################
APP_NAME=aero-sense
APP_ENV=development
LOG_LEVEL=info
DEBUG=false

#################################################
# GOOGLE CLOUD PLATFORM
#################################################
# Get these from: https://console.cloud.google.com/
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Service Account Credentials
# Download from: GCP Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

#################################################
# VERTEX AI CONFIGURATION
#################################################
# Create endpoint at: https://console.cloud.google.com/vertex-ai/endpoints
VERTEX_AI_ENDPOINT_ID=projects/YOUR_PROJECT_ID/locations/us-central1/endpoints/YOUR_ENDPOINT_ID
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=xgboost-rul-predictor

# Model Configuration
MODEL_VERSION=1.0.0
MODEL_PREDICTION_TIMEOUT=30

#################################################
# GEMINI API (Google AI Studio)
#################################################
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# Cost Controls
GEMINI_MAX_REQUESTS_PER_HOUR=1000
GEMINI_COST_ALERT_THRESHOLD=10.00

#################################################
# CONFLUENT CLOUD KAFKA
#################################################
# Production Kafka Configuration
# Sign up at: https://confluent.cloud/
# Promo code: CONFLUENTDEV1 (30-day free trial)

KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-central1.gcp.confluent.cloud:9092
KAFKA_SASL_USERNAME=your-confluent-api-key
KAFKA_SASL_PASSWORD=your-confluent-api-secret

# Topic Configuration
KAFKA_TOPIC=telemetry.enriched
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=3

# Consumer Configuration
KAFKA_CONSUMER_GROUP=ai-core-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_MAX_POLL_RECORDS=500

# Producer Configuration
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10

# Local Kafka (docker-compose)
# Use these when running locally
LOCAL_KAFKA_BOOTSTRAP_SERVERS=localhost:9093

#################################################
# REDIS CONFIGURATION
#################################################
# Production Redis (Google Memorystore)
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Local Redis (docker-compose)
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379

# Cache Configuration
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECTION_TIMEOUT=5

#################################################
# POSTGRESQL CONFIGURATION
#################################################
# Used for metadata and configuration storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aerosense
POSTGRES_USER=admin
POSTGRES_PASSWORD=SecurePassword123!

# Connection Pool
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5

#################################################
# BIGQUERY CONFIGURATION
#################################################
# Analytics and Long-term Storage
BIGQUERY_DATASET=aero_sense
BIGQUERY_TABLE_PREDICTIONS=predictions
BIGQUERY_TABLE_TELEMETRY=telemetry
BIGQUERY_TABLE_METRICS=metrics

# Batch Configuration
BIGQUERY_BATCH_SIZE=1000
BIGQUERY_FLUSH_INTERVAL=60

#################################################
# FIRESTORE CONFIGURATION
#################################################
# Real-time Database
FIRESTORE_COLLECTION_TELEMETRY=telemetry
FIRESTORE_COLLECTION_PREDICTIONS=predictions
FIRESTORE_COLLECTION_ALERTS=alerts

#################################################
# DATADOG CONFIGURATION
#################################################
# Sign up at: https://www.datadoghq.com/
# Start free trial: https://app.datadoghq.com/signup

# API Configuration
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com

# Agent Configuration
DATADOG_AGENT_HOST=localhost
DATADOG_DOGSTATSD_PORT=8125
DATADOG_TRACE_AGENT_PORT=8126

# Service Configuration
DD_ENV=production
DD_SERVICE=aero-sense
DD_VERSION=1.0.0
DD_TAGS=project:aero-sense,hackathon:google-cloud-2025

# APM Configuration
DD_TRACE_ENABLED=true
DD_PROFILING_ENABLED=true
DD_RUNTIME_METRICS_ENABLED=true

# Logs Configuration
DD_LOGS_ENABLED=true
DD_LOGS_INJECTION=true

# RUM (Real User Monitoring) - Frontend
DATADOG_CLIENT_TOKEN=your-datadog-client-token
DATADOG_APPLICATION_ID=your-datadog-application-id

# Custom Metrics Configuration
DD_HISTOGRAM_PERCENTILES=0.5,0.75,0.9,0.95,0.99
DD_DOGSTATSD_BUFFER_SIZE=8192

#################################################
# OPENWEATHER API
#################################################
# Sign up at: https://openweathermap.org/api
# Free tier: 1,000 calls/day
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_UNITS=metric

# Rate Limiting
OPENWEATHER_MAX_REQUESTS_PER_MINUTE=60
OPENWEATHER_CACHE_TTL=1800

#################################################
# GOOGLE MAPS API
#################################################
# Enable APIs at: https://console.cloud.google.com/apis/library
# Required APIs: Maps JavaScript API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

#################################################
# NASA CMAPSS DATASET
#################################################
# Dataset will be downloaded automatically
NASA_DATASET_URL=https://ti.arc.nasa.gov/c/6/
NASA_DATASET_PATH=./data
NASA_TRAIN_FILE=train_FD001.txt
NASA_TEST_FILE=test_FD001.txt
NASA_RUL_FILE=RUL_FD001.txt

#################################################
# ELEVENLABS (OPTIONAL)
#################################################
# Voice-based maintenance assistant
# Sign up at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=rachel
ELEVENLABS_MODEL=eleven_monolingual_v1

#################################################
# INGESTION SERVICE CONFIGURATION
#################################################
INGESTION_SERVICE_PORT=8080
INGESTION_BATCH_SIZE=100
INGESTION_WORKERS=4
INGESTION_RATE_LIMIT=1000

# Health Check
INGESTION_HEALTH_CHECK_INTERVAL=30

#################################################
# AI CORE SERVICE CONFIGURATION
#################################################
AI_CORE_SERVICE_PORT=8000
AI_CORE_WORKERS=2
AI_CORE_THREADS=4

# Model Configuration
RUL_THRESHOLD_CRITICAL=10
RUL_THRESHOLD_WARNING=20
RUL_THRESHOLD_NORMAL=40

# Gemini Trigger
GEMINI_TRIGGER_THRESHOLD=20
GEMINI_RETRY_COUNT=3
GEMINI_RETRY_DELAY=5

#################################################
# DASHBOARD UI CONFIGURATION
#################################################
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# UI Settings
NEXT_PUBLIC_REFRESH_INTERVAL=5000
NEXT_PUBLIC_MAX_TELEMETRY_POINTS=100
NEXT_PUBLIC_ENABLE_ANALYTICS=true

#################################################
# MONITORING & ALERTING
#################################################
# Slack Webhook for Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#aero-sense-alerts

# PagerDuty Integration
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# Email Alerts
ALERT_EMAIL_TO=team@example.com
ALERT_EMAIL_FROM=noreply@aero-sense.com

#################################################
# FEATURE FLAGS
#################################################
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true
ENABLE_PROFILING=false

# Experimental Features
ENABLE_MODEL_DRIFT_DETECTION=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_AUTO_SCALING=false

#################################################
# SECURITY & AUTHENTICATION
#################################################
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600

# API Keys (for internal services)
INTERNAL_API_KEY=your-internal-api-key

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

#################################################
# PERFORMANCE TUNING
#################################################
# Go Service
GO_MAX_PROCS=4
GO_GC_PERCENT=100

# Python Service
PYTHONUNBUFFERED=1
PYTHON_MAX_WORKERS=4
UVICORN_WORKERS=2

#################################################
# DEVELOPMENT SETTINGS
#################################################
# Set to 'true' in development only
DEV_MODE=true
DEV_MOCK_VERTEX_AI=false
DEV_MOCK_GEMINI=false
DEV_MOCK_WEATHER_API=false
DEV_SEED_DATA=true

#################################################
# CI/CD CONFIGURATION
#################################################
# GitHub Actions
CI=false
GITHUB_TOKEN=your-github-token

# Container Registry
CONTAINER_REGISTRY=gcr.io
CONTAINER_REGISTRY_PROJECT=your-gcp-project-id

#################################################
# TERRAFORM CONFIGURATION
#################################################
TF_VAR_project_id=your-gcp-project-id
TF_VAR_region=us-central1
TF_VAR_environment=production

#################################################
# BUDGET & COST CONTROLS
#################################################
# Daily budget limits (in USD)
MAX_DAILY_GEMINI_COST=5.00
MAX_DAILY_VERTEX_COST=10.00
MAX_DAILY_TOTAL_COST=20.00

# Alert thresholds
COST_ALERT_THRESHOLD_WARNING=15.00
COST_ALERT_THRESHOLD_CRITICAL=18.00

#################################################
# NOTES
#################################################
# 1. Generate strong passwords for production
# 2. Use Google Secret Manager in production
# 3. Enable VPC Service Controls for security
# 4. Set up Cloud Armor for DDoS protection
# 5. Configure Cloud CDN for static assets
# 6. Enable Cloud Audit Logs
# 7. Set up Budget Alerts in GCP Console
#################################################
